# Copy this file to ".env" (same folder) and fill in your Twilio details.
# Leave them empty to run in DEMO MODE (no real SMS, on-screen phone notification).
#
# Get free trial keys at https://www.twilio.com/try-twilio
# NOTE: a Twilio trial can only send SMS to phone numbers you have VERIFIED in the Twilio console.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Numbers that receive alerts, comma separated, with country code
ALERT_PHONE_NUMBERS=+91XXXXXXXXXX
